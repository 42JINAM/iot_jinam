Vagrant.configure("2") do |config|
    config.vm.box = "bento/ubuntu-24.04"
    config.vm.define "ymabsout" do |customVM|
        customVM.vm.hostname = "ymabsout"
        customVM.vm.network "private_network", ip:"192.168.56.110"
        customVM.vm.provider "virtualbox" do |vb|
            vb.memory ="1024"
            vb.cpus = "1"
        end
        customVM.vm.provision "shell", path:"scripts/install_docker_k3s_kubctl.sh"
        customVM.vm.provision "shell", path:"scripts/setup_k3d.sh"
        # customVM.vm.provision "shell", path:"scripts/init_kubie.sh"
        customVM.vm.provision "shell", path:"scripts/install_argocd.sh"
    end
end
